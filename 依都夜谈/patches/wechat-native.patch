diff --git a/pat.py b/pat.py
new file mode 100644
index 0000000..d258b25
--- /dev/null
+++ b/pat.py
@@ -0,0 +1,163 @@
+"""Parse WeChat group pat (拍一拍) system and appmsg events."""
+
+from __future__ import annotations
+
+import html
+import re
+import xml.etree.ElementTree as ET
+from dataclasses import dataclass
+
+_TAG_RE = re.compile(r"<[^>]+>")
+_QUOTES = "\"'“”‘’「」『』《》"
+_SELF_INITIATOR_RE = re.compile(r"^(?:你|我)[ 　]*拍了拍")
+_PAT_SPLIT_RE = re.compile(r"^(?P<sender>.*?)\s*(?:拍了拍|tickled)\s*(?P<target>.+)$", re.I)
+
+
+@dataclass(frozen=True)
+class PatEvent:
+    sender_id: str
+    sender_name: str
+    target_id: str
+    target_is_self: bool
+    raw_text: str
+
+
+def _clean_text(value: str) -> str:
+    text = html.unescape(_TAG_RE.sub("", value or ""))
+    return " ".join(text.split()).strip()
+
+
+def _strip_quotes(value: str) -> str:
+    return value.strip().strip(_QUOTES).strip()
+
+
+def _extract_xml_pat(body: str) -> tuple[str, str, str] | None:
+    stripped = body.strip()
+    if "<" not in stripped:
+        return None
+    start = stripped.find("<")
+    xml_text = stripped[start:]
+    try:
+        root = ET.fromstring(xml_text)
+    except ET.ParseError:
+        return None
+
+    # Format 1: <sysmsg type="pat"><pat>...</pat></sysmsg>
+    if root.tag == "sysmsg" and root.attrib.get("type") == "pat":
+        pat = root.find("pat")
+        if pat is None:
+            return None
+        sender = (pat.findtext("fromusername") or "").strip()
+        target = (pat.findtext("pattedusername") or "").strip()
+        template = (pat.findtext("template") or "").strip()
+        return sender, target, template
+
+    # Format 2: <msg><appmsg><type>62</type><patMsg><records><record>...</record></records></patMsg></appmsg></msg>
+    pat_msg = root.find(".//patMsg")
+    if pat_msg is not None:
+        records = pat_msg.findall(".//record")
+        if records:
+            latest = records[-1]
+            sender = (latest.findtext("fromUser") or latest.findtext("fromusername") or "").strip()
+            target = (latest.findtext("pattedUser") or latest.findtext("pattedusername") or "").strip()
+            template = (latest.findtext("template") or "").strip()
+            return sender, target, template
+    return None
+
+
+def _target_matches_self(target_text: str, bot_self_id: str, bot_names: tuple[str, ...]) -> bool:
+    cleaned = _strip_quotes(target_text)
+    if not cleaned:
+        return False
+    if cleaned.startswith("自己"):
+        return False
+    if cleaned == "我" or cleaned.startswith("我的") or cleaned.startswith("我 ") or cleaned.startswith("我，"):
+        return True
+    if bot_self_id and (cleaned == bot_self_id or f"${{{bot_self_id}}}" in target_text):
+        return True
+    for name in bot_names:
+        candidate = name.strip()
+        if not candidate:
+            continue
+        if cleaned == candidate or cleaned.startswith(candidate + "的") or cleaned.startswith(candidate + " "):
+            return True
+    return False
+
+
+def parse_pat(
+    raw: dict,
+    bot_self_id: str = "",
+    *,
+    bot_names: tuple[str, ...] = (),
+) -> PatEvent | None:
+    """Return a PatEvent when ``raw`` is a WeChat pat targeting the bot, else None."""
+    if not isinstance(raw, dict):
+        return None
+    if raw.get("direction") == "outgoing":
+        return None
+    msg_type = raw.get("type")
+    is_pat_type = msg_type in {10000, 10002} or (msg_type == 49 and raw.get("appMessageType") == 62)
+    if not is_pat_type:
+        return None
+
+    body = raw.get("body")
+    if not isinstance(body, str) or not body.strip():
+        return None
+
+    # Try structured XML first (sysmsg type="pat" or appmsg type=62 patMsg).
+    xml_pat = _extract_xml_pat(body)
+    if xml_pat is not None:
+        sender_id, target_id, template = xml_pat
+        if bot_self_id and sender_id == bot_self_id:
+            return None
+        target_is_self = bool(bot_self_id and target_id == bot_self_id)
+        if not target_is_self and template:
+            # Fallback to template text if target_id was absent.
+            plain_tpl = _clean_text(template)
+            match = _PAT_SPLIT_RE.match(plain_tpl)
+            if match and _target_matches_self(match.group("target"), bot_self_id, bot_names):
+                target_is_self = True
+        if not target_is_self:
+            return None
+        readable = _clean_text(template) or "拍了拍你"
+        sender_name = ""
+        match = _PAT_SPLIT_RE.match(readable)
+        if match:
+            candidate = _strip_quotes(match.group("sender"))
+            if candidate and not candidate.startswith("${"):
+                sender_name = candidate
+        return PatEvent(
+            sender_id=sender_id or (raw.get("senderId") if isinstance(raw.get("senderId"), str) else ""),
+            sender_name=sender_name,
+            target_id=target_id or bot_self_id,
+            target_is_self=True,
+            raw_text=readable,
+        )
+
+    # Fallback: plain or HTML-link system message text (type 10000/10002).
+    plain = _clean_text(body)
+    if not plain or ("拍了拍" not in plain and "tickled" not in plain.lower()):
+        return None
+    if _SELF_INITIATOR_RE.match(_strip_quotes(plain)):
+        return None
+    match = _PAT_SPLIT_RE.match(plain)
+    if not match:
+        return None
+    sender_name = _strip_quotes(match.group("sender"))
+    target_text = match.group("target").strip()
+    if sender_name in {"你", "我"}:
+        return None
+    if not _target_matches_self(target_text, bot_self_id, bot_names):
+        return None
+
+    raw_sender = raw.get("senderId")
+    sender_id = raw_sender if isinstance(raw_sender, str) and not raw_sender.endswith("@chatroom") else ""
+    if bot_self_id and sender_id == bot_self_id:
+        return None
+    return PatEvent(
+        sender_id=sender_id,
+        sender_name=sender_name,
+        target_id=bot_self_id,
+        target_is_self=True,
+        raw_text=plain,
+    )

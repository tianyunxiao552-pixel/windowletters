+@pytest.mark.asyncio
+@pytest.mark.parametrize("stream", [False, True])
+@pytest.mark.parametrize("free_error", [429, 503])
+async def test_gemini_free_fallback_is_per_request(monkeypatch, stream, free_error):
+    requests = []
+    limited = True
+    completion = {
+        "candidates": [
+            {
+                "content": {"role": "model", "parts": [{"text": "在呢"}]},
+                "finishReason": "STOP",
+            }
+        ],
+    }
+
+    def respond(request):
+        key = request.headers["x-goog-api-key"]
+        requests.append((key, request.content))
+        if key == "free-test-key" and limited:
+            return httpx.Response(
+                free_error,
+                json={
+                    "error": {
+                        "code": free_error,
+                        "status": "RESOURCE_EXHAUSTED"
+                        if free_error == 429
+                        else "UNAVAILABLE",
+                    }
+                },
+            )
+        if stream:
+            return httpx.Response(200, text=f"data: {json.dumps(completion)}\n\n")
+        return httpx.Response(200, json=completion)
+
+    original_init = httpx.AsyncClient.__init__
+
+    def mock_client_init(client, *args, **kwargs):
+        original_init(client, *args, **kwargs, transport=httpx.MockTransport(respond))
+
+    monkeypatch.setattr(httpx.AsyncClient, "__init__", mock_client_init)
+    provider = ProviderGoogleGenAI(
+        {
+            "id": "gemini_quota_test",
+            "api_base": "https://generativelanguage.googleapis.com/",
+            "model": "gemini-3.8-flash",
+            "key": ["free-test-key", "paid-test-key"],
+            "gm_rate_limit_fallback": True,
+        },
+        {},
+    )
+
+    async def ask():
+        options = {
+            "prompt": "依都在吗",
+            "system_prompt": "你叫依都",
+            "request_max_retries": 1,
+        }
+        if stream:
+            responses = [
+                response async for response in provider.text_chat_stream(**options)
+            ]
+            return responses[-1].completion_text
+        return (await provider.text_chat(**options)).completion_text
+
+    try:
+        assert await ask() == "在呢"
+        limited = False
+        assert await ask() == "在呢"
+    finally:
+        await provider.terminate()
+
+    assert [key for key, _ in requests] == [
+        "free-test-key",
+        "paid-test-key",
+        "free-test-key",
+    ]
+    assert requests[0][1] == requests[1][1]
+
+

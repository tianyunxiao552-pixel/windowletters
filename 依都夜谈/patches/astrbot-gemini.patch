+class GeminiFreeFirstAuth(httpx.Auth):
+    """Use the paid key when free-tier generation is rate-limited or unavailable."""
+
+    def __init__(self, paid_key: str) -> None:
+        self.paid_key = paid_key
+
+    def auth_flow(
+        self, request: httpx.Request
+    ) -> Generator[httpx.Request, httpx.Response, None]:
+        response = yield request
+        operation = request.url.path.rpartition(":")[2]
+        if response.status_code in {429, 503} and operation in {
+            "generateContent",
+            "streamGenerateContent",
+        }:
+            logger.info(
+                "Gemini free-tier request returned HTTP %s. Trying the paid fallback.",
+                response.status_code,
+            )
+            headers = request.headers.copy()
+            headers["x-goog-api-key"] = self.paid_key
+            yield httpx.Request(
+                request.method,
+                request.url,
+                headers=headers,
+                content=request.content,
+                extensions=request.extensions,
+            )
+
+
